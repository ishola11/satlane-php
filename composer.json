{
    "name": "satlane/satlane-php",
    "description": "Official PHP SDK for SatLane — non-custodial Bitcoin payments.",
    "license": "MIT",
    "type": "library",
    "version": "0.1.0",
    "homepage": "https://satlane.com",
    "support": {
        "docs": "https://satlane.com/docs",
        "source": "https://github.com/ishola11/satlane",
        "issues": "https://github.com/ishola11/satlane/issues"
    },
    "keywords": [
        "bitcoin",
        "payments",
        "satlane",
        "btc",
        "checkout",
        "non-custodial"
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-hash": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Satlane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Satlane\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
